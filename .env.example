# Copy to .env and fill in every value. Never commit .env.

# >= 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# URL-safe characters only (used inside the MongoDB URI), e.g. `openssl rand -hex 16`
MONGO_PASSWORD=

# Protects the TLS keystore, e.g. `openssl rand -hex 16`
SSL_KEYSTORE_PASSWORD=

# Password of the "root" account, created on first start if it does not exist (max 72 bytes).
# If unset when the account has to be created, the app asks for it on the console (or fails).
ROOT_PASSWORD=
